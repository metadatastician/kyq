;;
;; kyq Repository Deed
;; Kubernetes YAML Query - AffineScript KYAML processor
;; Owner: metadatastician
;
; One deed per repo (owner ruling D312). The identity, clade, forges,
; lineage, status, maturity, ecosystem, meta, agentic, neurosym and playbook
; clauses carry the former .machine_readable/descriptiles/kcq_<X>.deed files,
; folded here in the order rsr-template-repo_chora.deed uses. STATE's journal
; (milestones, blockers, next actions) is docs/status/ROADMAP.adoc; its
; completion percentage was dropped.
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "kyq"
  ; Name-based identifiers, as in rsr-template-repo. The former #u7 literal
  ; is replaced, not retagged: a v7 value under a #u5 tag would misstate
  ; the version nibble.
  ; Renamed kcq -> kyq on 2026-10-14 (ruling D333). The preimage keeps the
  ; original path on purpose: a name-based UUID identifies the repository,
  ; and a rename does not make it a new one (ADR-008; aliasing is
  ; standards#1230). Do not "fix" it to kyq.
  :repo-uuid #u5"github.com/metadatastician/kcq"
  :beholding-chora #u5"estate/chora"
  (identity
    :primary-forge github
    :owner "metadatastician"
    :prefixed-name "dx-kyq")
  ; The former CLADE record named "ky", which is not in the closed clade
  ; set. The owner chose dx on 2026-10-07.
  (clade
    :primary dx
    :primary-name "Developer Experience"
    :secondary (gv)
    :assigned "2026-10-05"
    :rationale "Developer Experience (`dx`): kyq is a command-line query and lint tool for Kubernetes YAML, a developer tool. gv as secondary: it inherits governance patterns from the metadatastician estate.")
  (forges
    :github "metadatastician/kyq"
    :gitlab "metadatastician/kyq"
    :bitbucket "metadatastician/kyq")
  (lineage
    :type standalone
    :parent ""
    :born "2026-10-05"
    :previous-names ())
  (status
    :phase active
    :since "2026-10-05"
    :present #t
    :aliases ()
    :merged-into ""
    :superseded-by ""
    :successors ()
    :ended ""
    (history
      (entry :phase active :since "2026-10-05" :note "Kubernetes YAML Query - AffineScript KYAML processor; initial development")))
  ; No command is implemented yet: AffineScript 0.1.1 does not parse any of
  ; the sources (docs/status/ROADMAP.adoc, Blockers).
  (maturity
    :level experimental)
  (ecosystem
    :project "kyq"
    :ecosystem "metadatastician"
    :purpose "Kubernetes YAML Query: an AffineScript-based KYAML processor intended as a smaller, K8s-aware alternative to yq."
    :language "AffineScript"
    :runtime "WebAssembly"
    (related :name "affinescript" :relationship compiler :notes "hyperpolymath/affinescript; the implementation language. Required.")
    (related :name "kubernetes" :relationship schema-source :notes "Kubernetes API schemas, v1.30.x; target versions v1.25 to v1.30.")
    (compatibility
      :yaml-versions ("YAML 1.2")
      :target-formats ("YAML" "JSON" "K8s manifests"))
    (targets
      :primary ("WebAssembly" "native binary")
      :secondary ("Docker container")
      :experimental ("WASI")))
  (meta
    :version "0.1.0"
    :last-updated "2026-10-07"
    :type binary
    :languages ("AffineScript")
    :license MPL-2.0
    :author "Jonathan D.A. Jewell (hyperpolymath)"
    :build-tool just
    :ci-platform github-actions
    :package-manager guix
    :scoping-first #t
    :execution-order "axis-1 > axis-2 > axis-3"
    :axis-1 "must > intend > like"
    :axis-2 "corrective > adaptive > perfective"
    :axis-3 "systems > compliance > effects"
    (design-rationale
      :primary "Intended: AffineScript type checking to give compile-time safety guarantees for YAML processing (not yet realised; no source compiles)"
      :secondary "Intended: K8s-specific parsing to allow domain-optimised processing"))
  ; The former AGENTIC record declared supported operations (parse, lint,
  ; query, get, set, del, format) and a `just ai-setup` command. None of
  ; them exists, so neither is carried over.
  (agentic
    :version "0.1.0"
    :last-updated "2026-10-07"
    (permissions :source #t :tests #t :docs #t :config #t :create-files #t)
    (integrity
      :fail-closed #t
      :require-evidence-per-step #t
      :allow-silent-skip #f
      :require-rerun-after-fix #t
      :release-claim-requires-hard-pass #t)
    (agent :id CLAUDE :role "AffineScript implementation, KYAML parser, integration")
    (agent :id GEMINI :role "Estate audits, cross-repo compliance, pattern detection")
    (agent :id VIBE :role "UI/frontend, rapid prototyping, agent panels"))
  (neurosym
    (metadata
      :version "0.1.0"
      :last-updated "2026-10-07")
    :enabled #f
    ; Planned symbolic components; none is implemented yet.
    (symbolic-components
      :parser "Lexer + Parser in AffineScript"
      :ast "Abstract Syntax Tree representation"
      :query-engine "Path-based query system"
      :linter "Rule-based validation"))
  (playbook
    (metadata
      :version "0.1.0"
      :last-updated "2026-10-07")
    (objective :id "yq-replacement" :priority "P0" :description "Replace yq with kyq for KYAML processing in the estate" :success-criteria "Performance >= yq, Memory < yq, Size < yq")
    (objective :id "affinescript-proof" :priority "P1" :description "Prove AffineScript is viable for text processing workloads" :success-criteria "Production-ready compiler, Sufficient performance")
    (objective :id "k8s-awareness" :priority "P1" :description "Provide K8s-aware YAML processing with domain validation" :success-criteria "All core K8s types supported, Lint rules effective")
    (success-metrics
      :parse-speed-target "50MB/s"
      :memory-target "<10MB"
      :startup-time-target "<100ms"
      :coverage-target "80%"
      :compliance-target "RSR Tier 2"))
  (manifest
    :version "0.1.0"
    :last-updated "2026-10-07"
    :project "kyq"
    :purpose "Kubernetes YAML Query — an AffineScript-based KYAML processor intended as a smaller, faster, K8s-aware alternative to yq; not yet functional. Designed to replace yq for Kubernetes workloads with compile-time safety guarantees and domain-specific validation."
    :license "MPL-2.0"
    :docs-license "CC-BY-SA-4.0"
    (agent :name CLAUDE :role "AffineScript implementation, KYAML parser, integration")
    (agent :name GEMINI :role "Estate audits, cross-repo compliance, pattern detection")
    (agent :name VIBE :role "UI/frontend, rapid prototyping, agent panels")
    (policy :rules ("Use AffineScript for all implementation" "Follow RSR Tier 2 standards" "MPL-2.0 for code, CC-BY-SA-4.0 for docs" "Maintain K9 coordination"))
    (work :agent CLAUDE :task "AffineScript KYAML parser implementation")
    (work :agent GEMINI :task "Estate compliance verification")
    (work :agent VIBE :task "Agent integration and prototyping")
  )
  (ply
    (directory :ply 1 :path ".github" :description "GitHub configuration and CI/CD workflows")
    (directory :ply 1 :path "bin" :description "Compiled binaries and build outputs")
    (directory :ply 1 :path "dist" :description "Distribution artifacts (WASM, releases)")
    (directory :ply 1 :path "examples" :description "Example Kubernetes manifests for testing and documentation")
    (directory :ply 1 :path "src" :description "Primary source code - AffineScript KYAML implementation")
    (directory :ply 2 :path "src/Kyaml" :description "KYAML core module")
    (directory :ply 3 :path "src/Kyaml/Lint" :description "Lint rules for Kubernetes resources")
    (directory :ply 1 :path "tests" :description "Test suite for KYAML parser and linter")
    (directory :ply 1 :path "benches" :description "Performance benchmarks")
    (directory :ply 1 :path "templates" :description "Kubernetes template files")
    (directory :ply 1 :path "gradings" :description "Grading configurations for compliance tracking")
    (directory :ply 1 :path "conformance" :description "Executable KYAML / I-JSON / JCS conformance gate; verification harness, not the implementation (docs/CONFORMANCE_GATE.adoc)")
    (directory :ply 0 :path "docs" :description "Documentation")
  )
)
