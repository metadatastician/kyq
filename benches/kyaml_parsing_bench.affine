module Kyaml.Benchmarks;

use Kyaml.Parser;

pub struct BenchmarkResult {
  name: String,
  operations: Int,
  duration_seconds: Float,
  ops_per_second: Float
}

pub fn bench_small_manifest() -> BenchmarkResult {
  #{ name: "small_manifest", operations: 1000, duration_seconds: 0.0, ops_per_second: 0.0 }
}
