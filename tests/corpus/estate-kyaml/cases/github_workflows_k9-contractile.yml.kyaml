# SPDX-License-Identifier: MPL-2.0
# Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
#
# K9-SVC contractile validation.
#
# Extracted from boj-build.yml. `K9-SVC contractile validation` is a REQUIRED
# status check, but boj-build.yml declares only `push:` and `workflow_dispatch:`
# - it has no `pull_request:` trigger at all, so the context could never report
# on a pull request and every PR deadlocked waiting for it.
#
# It lives in its own file rather than gaining a `pull_request:` trigger inside
# boj-build.yml so that a required check is not coupled to the BoJ integration:
# a change to the BoJ trigger cannot alter whether this gate reports.
#
# The job name below is VERBATIM from the required-context list. A required
# context is matched against the emitted job name, so renaming it silently
# un-gates the branch.
{
  name: "K9-SVC Contractile Validation",
  on: {
    push: {
      branches: [
        "main",
        "master",
      ],
    },
    pull_request: null,
    workflow_dispatch: null,
  },
  concurrency: {
    group: "${{ github.workflow }}-${{ github.ref }}",
    cancel-in-progress: true,
  },
  permissions: {
    contents: "read",
  },
  jobs: {
    validate-contractiles: {
      name: "K9-SVC contractile validation",
      timeout-minutes: 10,
      runs-on: "ubuntu-latest",
      # Needed only by the final step, which posts the validator's verdict to
      # the pull request. Log blobs are not reachable from every machine that
      # needs the result, so the result is published where it can be read.
      permissions: {
        contents: "read",
        pull-requests: "write",
      },
      steps: [
        {
          name: "Checkout",
          uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1", # v7.0.1
          with: {
            fetch-depth: 0,
            ref: "${{ github.event.pull_request.head.sha || github.sha }}",
            persist-credentials: false,
          },
        },
        {
          name: "Install Bun for Mustfile enforcement and reporting",
          uses: "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6", # v2.2.0
          with: {
            bun-version: "1.4.2",
          },
        },
        {
          name: "K9-SVC Validation",
          run: "set -euo pipefail\necho \"Running K9-SVC contractile validation...\"\n# Real structural validation (no placeholder): every Mustfile check\n# must carry a severity and a means of discharge (run or verification).\n# A hollow check fails loudly. See scripts/check-mustfile-structure.sh\n# (unit-tested by scripts/tests/wave0-false-green-test.sh).\nbash scripts/check-mustfile-structure.sh\n",
        },
        {
          name: "Mustfile Enforcement (execute the checks)",
          run: "set -euo pipefail\n# Execute the Mustfile's `- run:` invariants — the mandatory checks\n# that were previously declared but never run by any CI job. A failing\n# critical/high check fails the build (fail loudly); warning-severity\n# failures are reported but non-blocking. See scripts/run-mustfile.sh.\nbash scripts/run-mustfile.sh\n",
        },
        {
          name: "Contractile Check",
          run: "set -euo pipefail\necho \"Checking contractile completeness...\"\nindex=\".machine_readable/contractiles/INDEX.a2ml\"\nif [ ! -f \"$index\" ]; then\n  echo \"❌ Contractile registry not found: $index\"\n  exit 1\nfi\n# Read the canonical verb set from the registry rather than hard-coding\n# it (INDEX.a2ml §Registry: consumers SHOULD discover verbs from here).\n# Each verb's trident lists \"<verb>/<Verb>file.a2ml\" as its first entry.\nmapfile -t files < <(grep -oE '\"[a-z]+/[A-Z][a-z]+file\\.a2ml\"' \"$index\" | tr -d '\"' | sort -u)\nif [ \"${#files[@]}\" -eq 0 ]; then\n  echo \"❌ No contractile files discovered in $index\"\n  exit 1\nfi\nmissing=0\nfor rel in \"${files[@]}\"; do\n  if [ -f \".machine_readable/contractiles/$rel\" ]; then\n    echo \"✅ $rel\"\n  else\n    echo \"❌ Missing: $rel\"\n    missing=$((missing + 1))\n  fi\ndone\nif [ \"$missing\" -gt 0 ]; then\n  echo \"❌ $missing contractile(s) missing\"\n  exit 1\nfi\necho \"✅ All ${#files[@]} contractiles present\"\n",
        },
        # ── K9 CONTRACT CONFORMANCE (standards#1058, ruling D173) ──────────
        #
        # Everything above this line checks that contractile FILES EXIST. None of
        # it checked that a `.k9.ncl` file is a valid K9 component: the local hook
        # grepped for a line beginning `contract`, which no file in this repo has,
        # and ci-pipeline.yml excludes `*.k9.ncl` from Nickel entirely. So the
        # required check named "K9-SVC contractile validation" validated the
        # registry and never once read a pedigree.
        #
        # Nickel is installed here, pinned and sha256-verified with the SAME pin
        # as ci-pipeline.yml's `nickel` job — one version estate-wide, so a file
        # cannot typecheck in one lane and not in another.
        {
          name: "Install Nickel (pinned, sha256-verified)",
          env: {
            NICKEL_VERSION: "1.18.0",
            NICKEL_SHA256: "9cba4dd65ae9915ec61f73033aafcff307a377665a83fd8f530df086763318cb",
          },
          run: "set -euo pipefail\nURL=\"https://github.com/tweag/nickel/releases/download/${NICKEL_VERSION}/nickel-x86_64-linux\"\ncurl -sSfL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 -o \"$RUNNER_TEMP/nickel\" \"$URL\"\necho \"${NICKEL_SHA256}  ${RUNNER_TEMP}/nickel\" | sha256sum -c -\nchmod +x \"$RUNNER_TEMP/nickel\"\necho \"$RUNNER_TEMP\" >> \"$GITHUB_PATH\"\n",
        },
        {
          name: "Reporting regression tests",
          run: "bun test 1-formats/k9/tools/conformance-report.test.mjs",
        },
        {
          name: "Collect DEED and K9 evidence",
          if: "${{ always() }}",
          env: {
            PR_NUMBER: "${{ github.event.pull_request.number || 'local' }}",
            K9_BASE_SHA: "${{ github.event.pull_request.base.sha }}",
            K9_HEAD_SHA: "${{ github.event.pull_request.head.sha || github.sha }}",
          },
          run: "set -euo pipefail\nif command -v bun >/dev/null; then\n  bun 1-formats/k9/tools/conformance-report.mjs\nelse\n  node 1-formats/k9/tools/conformance-report.mjs\nfi\n",
        },
        {
          name: "Archive dated conformance evidence",
          if: "${{ always() && env.K9_REPORT_DIR != '' }}",
          uses: "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9", # v7.0.2
          with: {
            name: "conformance-evidence-${{ github.run_id }}-${{ github.run_attempt }}",
            path: "${{ env.K9_REPORT_DIR }}",
            if-no-files-found: "error",
            retention-days: 90,
          },
        },
        {
          name: "Update the compact PR verdict",
          if: "${{ always() && github.event_name == 'pull_request' && env.K9_REPORT_DIR != '' }}",
          env: {
            GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}",
            PR_NUMBER: "${{ github.event.pull_request.number }}",
          },
          run: "set -euo pipefail\ncomment_id=\"$(gh api --paginate --slurp \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments\" \\\n  | jq -r '[.[][] | select(.user.login == \"github-actions[bot]\" and (.body | contains(\"<!-- k9-contractile-report:\")))] | last | .id // \"\"')\"\njq -n --rawfile body \"$K9_REPORT_DIR/report.md\" '{body: $body}' > \"$RUNNER_TEMP/k9-comment.json\"\nif [ -n \"$comment_id\" ]; then\n  gh api -X PATCH \"repos/$GITHUB_REPOSITORY/issues/comments/$comment_id\" --input \"$RUNNER_TEMP/k9-comment.json\" >/dev/null\nelse\n  gh api -X POST \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments\" --input \"$RUNNER_TEMP/k9-comment.json\" >/dev/null\nfi\n",
        },
      ],
    },
  },
}
