# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
#
# fork-governance-reusable.yml — post the Fork governance summary on a pull
# request, with the lanes in a fixed order:
#
#   1. summary        DEED syntax · K9-DEED conformance · Hypatia verdict grid
#   2. K9-DEED conformance grid
#   3. Hypatia verdict grid
#
# This workflow POSTS; it does not run the lanes. A reusable cannot read the
# caller's `needs` graph, so the caller passes its lane results and verdicts in
# as inputs. That is deliberate: the posting step must not be able to invent a
# lane outcome, and a lane that never ran has no result to pass — it renders
# orange, which is the truth.
#
# WHY THE LANES DO NOT POST THEMSELVES. `k9-conformance.yml` and
# `hypatia-scan-reusable.yml` render grids and publish artifacts. They ask for
# no write permission, because a reusable may not request more than its caller
# grants and most callers grant only reads. This workflow is the single place
# that is allowed to write to a pull request, so there is exactly one comment,
# one marker, and one update loop per repository.
#
# FORK PULL REQUESTS. On a pull request from a fork GitHub hands every job a
# read-only token, whatever the caller grants, so this job cannot write the
# comment there. It still renders it (the step summary always carries it), and
# instead of posting it uploads the body as the `fork-governance-comment`
# artifact. fork-governance-publish-reusable.yml, called from a `workflow_run`
# workflow that runs with the base repository's token, publishes it. A run
# that cannot post therefore never fails for that reason alone.
#
# Documented in 3-practice/fork-governance/ (SPEC.adoc, LANES.adoc,
# ADOPTION.adoc). Read those before changing the comment shape: the markers are
# a contract with every downstream reader.

{
  name: "Fork governance (reusable)",
  on: {
    workflow_call: {
      inputs: {
        pr-number: {
          description: "Pull request number to comment on. Pass github.event.pull_request.number.",
          type: "string",
          required: true,
        },
        deed-result: {
          description: "needs.<deed job>.result",
          type: "string",
          required: false,
          default: "",
        },
        k9-result: {
          description: "needs.<k9 job>.result",
          type: "string",
          required: false,
          default: "",
        },
        k9-verdict: {
          description: "needs.<k9 job>.outputs.verdict — green, yellow, orange, red or grey.",
          type: "string",
          required: false,
          default: "",
        },
        k9-artifact: {
          description: "Artifact name carrying k9-grid/report.md. Empty to skip the download.",
          type: "string",
          required: false,
          default: "k9-grid",
        },
        hypatia-result: {
          description: "needs.<hypatia job>.result",
          type: "string",
          required: false,
          default: "",
        },
        hypatia-verdict: {
          description: "needs.<hypatia job>.outputs.verdict — green, yellow, orange, red, purple or grey.",
          type: "string",
          required: false,
          default: "",
        },
        hypatia-artifact: {
          description: "Artifact name carrying verdict-grid/report.md. Empty to skip the download.",
          type: "string",
          required: false,
          default: "verdict-grid",
        },
        hypatia-advisory: {
          description: "needs.<hypatia job>.outputs.advisory — `<state>:<critical>:<high>` or `none`. Shown beside the verdict so an advisory critical is visible without being able to grade the change. Empty is fine.",
          type: "string",
          required: false,
          default: "",
        },
        grid-author: {
          description: "The account whose previous comment is read as the baseline. Only this account's comment is trusted.",
          type: "string",
          required: false,
          default: "github-actions[bot]",
        },
        canon-ref: {
          description: "Ref of metadatastician/standards holding the renderer. Leave EMPTY to use this reusable's own commit (job.workflow_sha), which is the standards commit the caller pinned. Setting it to a branch (the old default, \"main\") makes every already-pinned caller run whatever standards pushed most recently — a float, not a pin; a 40-hex commit is accepted when a caller deliberately needs another one.",
          type: "string",
          required: false,
          default: "",
        },
      },
    },
  },
  permissions: {},
  jobs: {
    post: {
      name: "Post the fork governance summary",
      # Always: a lane that failed is exactly when the summary matters most.
      if: "${{ always() && inputs.pr-number != '' }}",
      runs-on: "ubuntu-latest",
      timeout-minutes: 5,
      permissions: {
        contents: "read",
        actions: "read",
        pull-requests: "write",
      },
      steps: [
        # In this repository the renderer is already checked out below the
        # workspace; anywhere else it comes from the canon at a pinned ref.
        {
          name: "Checkout the caller",
          if: "${{ github.repository_id == 1116521501 }}",
          uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1", # v7.0.1
          with: {
            persist-credentials: false,
            sparse-checkout: "scripts/fork-governance-render.sh\nscripts/reviewer-coverage.sh\n",
            sparse-checkout-cone-mode: false,
          },
        },
        # Optional metadata helper, not a test gate: failure is rendered as
        # indeterminate coverage while the three lane reports remain available.
        {
          name: "Fetch the coverage helper independently of canon-ref",
          if: "${{ github.repository_id != 1116521501 }}",
          continue-on-error: true,
          uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1", # v7.0.1
          with: {
            repository: "metadatastician/standards",
            ref: "${{ job.workflow_sha }}",
            path: ".fork-governance-coverage",
            persist-credentials: false,
            sparse-checkout: "scripts/reviewer-coverage.sh",
            sparse-checkout-cone-mode: false,
          },
        },
        {
          name: "Checkout the canon",
          if: "${{ github.repository_id != 1116521501 }}",
          uses: "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1", # v7.0.1
          with: {
            repository: "metadatastician/standards",
            # `inputs.canon-ref` when a caller names one, otherwise this
            # reusable's own commit. Never a silent branch: the empty-string
            # default previously meant `main`, so one push to standards changed
            # the renderer of every already-pinned caller.
            ref: "${{ inputs.canon-ref || job.workflow_sha }}",
            path: ".fork-governance-canon",
            persist-credentials: false,
            sparse-checkout: "scripts/fork-governance-render.sh\n",
            sparse-checkout-cone-mode: false,
          },
        },
        # `continue-on-error` on both downloads, and never a condition on the
        # posting step: an artifact that did not upload is a fact to report
        # (orange row), not a reason to post nothing. A summary that fails to
        # appear when things went wrong is worse than no summary at all.
        {
          name: "Download the k9-deed grid",
          if: "${{ inputs.k9-artifact != '' }}",
          continue-on-error: true,
          uses: "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333", # v8.0.2
          with: {
            name: "${{ inputs.k9-artifact }}",
            path: "k9-grid",
          },
        },
        {
          name: "Download the Hypatia verdict grid",
          if: "${{ inputs.hypatia-artifact != '' }}",
          continue-on-error: true,
          uses: "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333", # v8.0.2
          with: {
            name: "${{ inputs.hypatia-artifact }}",
            path: "verdict-grid",
          },
        },
        {
          name: "Render the combined verdict",
          id: "render",
          env: {
            DEED_RESULT: "${{ inputs.deed-result }}",
            K9_RESULT: "${{ inputs.k9-result }}",
            K9_VERDICT: "${{ inputs.k9-verdict }}",
            HYPATIA_RESULT: "${{ inputs.hypatia-result }}",
            HYPATIA_VERDICT: "${{ inputs.hypatia-verdict }}",
            HYPATIA_ADVISORY: "${{ inputs.hypatia-advisory }}",
            PR_NUMBER: "${{ inputs.pr-number }}",
            GH_TOKEN: "${{ github.token }}",
            RENDERER: "${{ github.repository_id == 1116521501 && 'scripts/fork-governance-render.sh' || '.fork-governance-canon/scripts/fork-governance-render.sh' }}",
            COVERAGE_HELPER: "${{ github.repository_id == 1116521501 && 'scripts/reviewer-coverage.sh' || '.fork-governance-coverage/scripts/reviewer-coverage.sh' }}",
          },
          run: "set -euo pipefail\n[ -f \"$RENDERER\" ] || { echo \"::error::renderer not found at $RENDERER\"; exit 1; }\n# Read metadata only, never code from a PR. API failure is an explicit\n# unknown coverage snapshot and must not suppress the three lane grids.\ncoverage=\"$RUNNER_TEMP/reviewer-coverage.md\"\nprintf '%s\\n' '**External reviewer coverage:** INDETERMINATE — evidence unavailable; no approval inferred.' > \"$coverage\"\nif [[ \"$PR_NUMBER\" =~ ^[0-9]+$ ]] &&\n   head=$(gh api \"repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER\" --jq .head.sha) &&\n   gh api --paginate --slurp \"repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER/reviews?per_page=100\" > \"$RUNNER_TEMP/reviews.json\" &&\n   gh api --paginate --slurp \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments?per_page=100\" > \"$RUNNER_TEMP/review-comments.json\" &&\n   checked_head=$(gh api \"repos/$GITHUB_REPOSITORY/pulls/$PR_NUMBER\" --jq .head.sha); then\n  helper=\"$COVERAGE_HELPER\"\n  if [ -f \"$helper\" ]; then\n    bash \"$helper\" \"$head\" \"$RUNNER_TEMP/reviews.json\" \\\n      \"$RUNNER_TEMP/review-comments.json\" \"$checked_head\" > \"$coverage.new\" || true\n    [ ! -s \"$coverage.new\" ] || mv \"$coverage.new\" \"$coverage\"\n  fi\nfi\nargs=(--out \"$RUNNER_TEMP/fork-governance\"\n      --deed-result \"$DEED_RESULT\"\n      --k9-result \"$K9_RESULT\" --k9-verdict \"$K9_VERDICT\"\n      --hypatia-result \"$HYPATIA_RESULT\" --hypatia-verdict \"$HYPATIA_VERDICT\"\n      --hypatia-advisory \"${HYPATIA_ADVISORY:-}\"\n      --sha \"$GITHUB_SHA\" --run \"$GITHUB_RUN_ID\" --repo \"$GITHUB_REPOSITORY\")\n[ -s k9-grid/report.md ] && args+=(--k9-report k9-grid/report.md)\n[ -s verdict-grid/report.md ] && args+=(--hypatia-report verdict-grid/report.md)\nbash \"$RENDERER\" \"${args[@]}\" >/dev/null\n# Older canon-ref renderers do not accept coverage arguments. Append\n# outside the versioned renderer, only within the publisher's budget.\nbody=\"$RUNNER_TEMP/fork-governance/body.md\"\n# Recent older renderers emit this exact trailing fallback when no\n# coverage argument is supplied. Remove only that known footer;\n# lane text containing the same words remains untouched.\nif awk -v legacy='**External reviewer coverage:** INDETERMINATE — not collected; no review or approval inferred.' '\n  { lines[NR]=$0 }\n  END {\n    last=NR\n    while (last>0 && lines[last]==\"\") last--\n    if (lines[last]==legacy) { last--; for (i=1;i<=last;i++) print lines[i] }\n    else { exit 3 }\n  }' \"$body\" > \"$body.new\"; then\n  mv \"$body.new\" \"$body\"\nelse\n  status=$?\n  rm -f \"$body.new\"\n  [ \"$status\" -eq 3 ] || exit \"$status\"\nfi\n# Always append our own section. Lane finding text is untrusted and\n# cannot suppress it by mentioning reviewer coverage or its marker.\nmarker='<!-- fork-governance:reviewer-coverage -->'\n# Reserve 2048 bytes for the fork publisher notice and run stamp.\nif [ \"$(( $(wc -c < \"$body\") + $(wc -c < \"$coverage\") + ${#marker} + 2 ))\" -le 62952 ]; then\n    printf '\\n%s\\n' \"$marker\" >> \"$body\"\n    cat \"$coverage\" >> \"$body\"\nelse\n    echo '::warning::Reviewer coverage omitted to preserve the governance comment size budget.'\nfi\n{\n  echo \"## Fork governance\"\n  echo\n  cat \"$RUNNER_TEMP/fork-governance/body.md\"\n} >> \"$GITHUB_STEP_SUMMARY\"\n",
        },
        # A fork PR's token is read-only, so posting would fail. Hand the body
        # to the workflow_run publisher instead (see the header). On any other
        # event the head repository is this one, or absent (workflow_dispatch).
        {
          name: "Decide who posts",
          id: "target",
          env: {
            HEAD_REPO: "${{ github.event.pull_request.head.repo.full_name }}",
          },
          run: "set -euo pipefail\nif [ -n \"$HEAD_REPO\" ] && [ \"$HEAD_REPO\" != \"$GITHUB_REPOSITORY\" ]; then\n  echo \"fork=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"Fork pull request ($HEAD_REPO): the comment is handed to the workflow_run publisher.\"\nelse\n  echo \"fork=false\" >> \"$GITHUB_OUTPUT\"\nfi\n",
        },
        {
          name: "Package the comment for the publisher",
          if: "${{ steps.target.outputs.fork == 'true' }}",
          env: {
            PR_NUMBER: "${{ inputs.pr-number }}",
            HEAD_SHA: "${{ github.event.pull_request.head.sha }}",
          },
          run: "set -euo pipefail\njq -n --arg pr \"$PR_NUMBER\" --arg sha \"$HEAD_SHA\" --arg run \"$GITHUB_RUN_ID\" \\\n  '{pr_number: $pr, head_sha: $sha, run_id: $run}' \\\n  > \"$RUNNER_TEMP/fork-governance/meta.json\"\n",
        },
        {
          name: "Upload the comment for the publisher",
          if: "${{ steps.target.outputs.fork == 'true' }}",
          uses: "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9", # v7.0.2
          with: {
            name: "fork-governance-comment",
            path: "${{ runner.temp }}/fork-governance/body.md\n${{ runner.temp }}/fork-governance/meta.json\n",
            if-no-files-found: "error",
            retention-days: 3,
          },
        },
        {
          name: "Publish the comment",
          if: "${{ steps.target.outputs.fork != 'true' }}",
          env: {
            GH_TOKEN: "${{ github.token }}",
            PR_NUMBER: "${{ inputs.pr-number }}",
            GRID_AUTHOR: "${{ inputs.grid-author }}",
          },
          run: "set -euo pipefail\n# One comment per pull request, updated in place. The marker is read\n# before the body is written, so a rerun of the same commit cannot\n# produce two comments and a reader cannot see two verdicts at once.\ncomment_id=$(gh api --paginate --slurp \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments\" \\\n  | jq -r --arg a \"$GRID_AUTHOR\" \\\n      '[.[][] | select((.user.login // \"\") == $a and ((.body // \"\") | contains(\"<!-- fork-governance-verdict:\")))]\n       | last | .id // \"\"')\njq -n --rawfile body \"$RUNNER_TEMP/fork-governance/body.md\" '{body: $body}' \\\n  > \"$RUNNER_TEMP/fork-governance/comment.json\"\nif [ -n \"$comment_id\" ]; then\n  gh api -X PATCH \"repos/$GITHUB_REPOSITORY/issues/comments/$comment_id\" \\\n    --input \"$RUNNER_TEMP/fork-governance/comment.json\" >/dev/null\n  echo \"updated the fork governance comment on #$PR_NUMBER ($comment_id)\"\nelse\n  gh api -X POST \"repos/$GITHUB_REPOSITORY/issues/$PR_NUMBER/comments\" \\\n    --input \"$RUNNER_TEMP/fork-governance/comment.json\" >/dev/null\n  echo \"posted the fork governance comment on #$PR_NUMBER\"\nfi\n",
        },
      ],
    },
  },
}
