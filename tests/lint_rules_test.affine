// kyq Lint Rules Tests — stub that type-checks; real cases in Phase 1

module Kyaml.Lint.Test;

use Kyaml;
use Kyaml.Ast;
use Kyaml.Parser;
use prelude::{ Option, Some, None };

pub type TestResult =
    TestPass
  | TestFail(String)

pub fn test_required_fields_rule_valid() -> TestResult {
  let yaml: String = "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: test-deployment\n";
  match Parser::parse_yaml(yaml) {
    ParseSuccess(_doc) => {
      let issues = Kyaml::lint_k8s(yaml);
      if len(issues) == 0 {
        TestPass
      } else {
        TestFail("Expected no issues")
      }
    },
    ParseError(err) => TestFail("Parse failed: " ++ err.message)
  }
}
