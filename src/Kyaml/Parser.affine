// KYAML Parser — stub that type-checks; full parsing in Phase 1 (A3)

module Kyaml.Parser;

use Kyaml.Ast;
use Kyaml.Lexer;
use prelude::{ Option, Some, None };

pub struct ParserState {
  tokens: [PositionedToken],
  position: Int
}

pub fn new(input: String) -> ParserState {
  let lex = Lexer::new(input);
  let toks = Lexer::tokenize(lex);
  #{ tokens: toks, position: 0 }
}

pub fn parse_yaml(input: String) -> ParseResult {
  // stub: return a minimal document containing the input as a string scalar
  // so that lint and query harnesses have a valid doc to walk
  let doc: AstDocument = #{
    version: None,
    tags: None,
    root: YamlString(input),
    resources: []
  };
  ParseSuccess(doc)
}

pub fn parse_k8s_resources(input: String) -> [K8sResource] {
  // stub: no resources extracted until full parser lands
  []
}

// helper used by Kyaml.affine's query stub
pub fn parse_int_stub(s: String) -> Option[Int] {
  None
}
