//
// KYAML Parser — minimal block YAML parser for K8s manifests
// Handles the 2-space indent style used in examples/deployment.yaml and
// tests/fixtures/invalid-deployment.yaml. Full YAML 1.2 in Phase 3.

module Kyaml.Parser;

use Kyaml.Ast::*;
use prelude::{ Option, Some, None };

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn get_indent(line: String) -> Int {
  let mut i: Int = 0;
  let mut scanning: Bool = true;
  while scanning && i < len(line) {
    let ch = string_get(line, i);
    if ch == ' ' || ch == '\t' {
      i = i + 1;
    } else {
      scanning = false;
    }
  }
  i
}

fn mapping_has_key(pairs: [(String, YamlValue)], key: String) -> Bool {
  let mut j: Int = 0;
  while j < len(pairs) {
    let (existing_key, _) = pairs[j];
    if existing_key == key {
      return true;
    }
    j = j + 1;
  }
  false
}

fn trim(s: String) -> String {
  let mut start: Int = 0;
  let mut end: Int = len(s);
  let mut trimming_start: Bool = true;
  while trimming_start && start < end {
    let ch = string_get(s, start);
    if ch == ' ' || ch == '\t' || ch == '\r' {
      start = start + 1;
    } else {
      trimming_start = false;
    }
  }
  let mut trimming_end: Bool = true;
  while trimming_end && end > start {
    let ch = string_get(s, end - 1);
    if ch == ' ' || ch == '\t' || ch == '\r' {
      end = end - 1;
    } else {
      trimming_end = false;
    }
  }
  string_sub(s, start, end - start)
}

fn is_empty_line(line: String) -> Bool {
  trim(line) == "" || string_get(trim(line), 0) == '#'
}

fn is_list_item(line: String) -> Bool {
  let t = trim(line);
  t == "-" || (len(t) >= 2 && string_get(t, 0) == '-' && string_get(t, 1) == ' ')
}

fn strip_list_prefix(line: String) -> String {
  let t = trim(line);
  // "- " is 2 chars
  if len(t) < 2 { return ""; }
  string_sub(t, 2, len(t) - 2)
}

fn split_first_colon(s: String) -> Option[(String, String)] {
  let mut i: Int = 0;
  while i < len(s) {
    let ch = string_get(s, i);
    if ch == ':' && (i + 1 == len(s) || string_get(s, i + 1) == ' ') {
      let k = trim(string_sub(s, 0, i));
      let v = trim(string_sub(s, i + 1, len(s) - (i + 1)));
      return Some((k, v));
    }
    i = i + 1;
  }
  None
}

fn parse_scalar(s: String) -> YamlValue {
  let t = trim(s);
  if t == "" { return YamlNull; }
  if t == "null" || t == "Null" || t == "~" { return YamlNull; }
  if t == "true" || t == "True" { return YamlBool(true); }
  if t == "false" || t == "False" { return YamlBool(false); }
  // integers: optional leading '-' + digits
  let mut is_int: Bool = true;
  let mut i: Int = 0;
  if len(t) > 0 && string_get(t, 0) == '-' {
    if len(t) == 1 { is_int = false; } else { i = 1; }
  }
  while is_int && i < len(t) {
    let ch = string_get(t, i);
    if ch < '0' || ch > '9' {
      is_int = false;
    } else {
      i = i + 1;
    }
  }
  if is_int {
    match parse_int(t) {
      Some(n) => return YamlInt(n),
      None => ()
    }
  }
  // strip quotes if present
  if len(t) >= 2 && string_get(t, 0) == '"' && string_get(t, len(t)-1) == '"' {
    return YamlString(string_sub(t, 1, len(t)-2));
  }
  if len(t) >= 2 && string_get(t, 0) == '\'' && string_get(t, len(t)-1) == '\'' {
    return YamlString(string_sub(t, 1, len(t)-2));
  }
  YamlString(t)
}

fn parse_int(s: String) -> Option[Int] {
  // reuse stdlib pattern: handle optional '-' then digits
  if len(s) == 0 { return None; }
  let mut sign: Int = 1;
  let mut i: Int = 0;
  if string_get(s, 0) == '-' {
    sign = 0 - 1;
    i = 1;
    if len(s) == 1 { return None; }
  }
  let mut n: Int = 0;
  while i < len(s) {
    let ch = string_get(s, i);
    if ch < '0' || ch > '9' { return None; }
    n = n * 10 + (char_to_int(ch) - char_to_int('0'));
    i = i + 1;
  }
  Some(sign * n)
}

fn split_lines(s: String) -> [String] {
  let mut out: [String] = [];
  let mut cur: String = "";
  let mut i: Int = 0;
  while i < len(s) {
    let ch = string_get(s, i);
    if ch == '\n' {
      out = out ++ [cur];
      cur = "";
    } else {
      cur = cur ++ string_sub(s, i, 1);
    }
    i = i + 1;
  }
  out = out ++ [cur];
  out
}

// ---------------------------------------------------------------------------
// Core block parser: parses a mapping or sequence at a given indent
// ---------------------------------------------------------------------------

type BlockResult =
    BlockSuccess(YamlValue, Int)
  | BlockError(ParseErrorDetail)

fn line_error(line: String, index: Int, message: String) -> ParseErrorDetail {
  #{
    message: message,
    line: Some(index + 1),
    column: Some(get_indent(line) + 1),
    context: Some(line)
  }
}

fn is_document_separator(line: String) -> Bool {
  let t = trim(line);
  if len(t) < 3 { return false; }
  let marker = string_sub(t, 0, 3);
  if marker != "---" && marker != "..." { return false; }
  if len(t) == 3 { return true; }
  let ch = string_get(t, 3);
  (ch == ' ' || ch == '\t') && is_empty_line(string_sub(t, 3, len(t) - 3))
}

fn parse_block(lines: [String], start: Int, base_indent: Int) -> BlockResult {
  // look ahead to decide if this block is a mapping or sequence
  let mut j: Int = start;
  while j < len(lines) && is_empty_line(lines[j]) {
    j = j + 1;
  }
  if j >= len(lines) {
    return BlockSuccess(YamlMapping([]), j);
  }
  let indent = get_indent(lines[j]);
  if indent < base_indent {
    return BlockSuccess(YamlMapping([]), j);
  }
  // check first non-empty line at this indent
  if is_list_item(lines[j]) {
    return parse_sequence(lines, j, indent);
  } else {
    return parse_mapping(lines, j, indent);
  }
}

fn parse_mapping(lines: [String], start: Int, base_indent: Int) -> BlockResult {
  let mut pairs: [(String, YamlValue)] = [];
  let mut i: Int = start;
  let mut parsing: Bool = true;
  while parsing && i < len(lines) {
    if is_empty_line(lines[i]) {
      i = i + 1;
    } else {
      let indent = get_indent(lines[i]);
      if indent != base_indent || is_list_item(lines[i]) {
        // A different indentation or collection kind terminates this block.
        parsing = false;
      } else {
        let line = trim(lines[i]);
        match split_first_colon(line) {
          Some((k, v)) => {
            if mapping_has_key(pairs, k) {
              panic("Duplicate mapping key '" ++ k ++ "' at line " ++ to_string(i));
            }
            if v != "" {
              let scalar = parse_scalar(v);
              pairs = pairs ++ [(k, scalar)];
              i = i + 1;
            } else {
              // A child mapping must be deeper; a sequence may share the key's indent.
              let mut peek: Int = i + 1;
              while peek < len(lines) && is_empty_line(lines[peek]) {
                peek = peek + 1;
              }
              if peek < len(lines) && (get_indent(lines[peek]) > base_indent ||
                  (get_indent(lines[peek]) == base_indent && is_list_item(lines[peek]))) {
                match parse_block(lines, peek, base_indent) {
                  BlockSuccess(nested, next_i) => {
                    pairs = pairs ++ [(k, nested)];
                    i = next_i;
                  },
                  BlockError(err) => return BlockError(err)
                }
              } else {
                pairs = pairs ++ [(k, YamlNull)];
                i = i + 1;
              }
            }
          },
          None => {
            return BlockError(line_error(lines[i], i, "Expected a mapping entry with ':'"));
          }
        }
      }
    }
  }
  BlockSuccess(YamlMapping(pairs), i)
}

fn parse_sequence(lines: [String], start: Int, base_indent: Int) -> BlockResult {
  let mut items: [YamlValue] = [];
  let mut i: Int = start;
  let mut parsing: Bool = true;
  while parsing && i < len(lines) {
    if is_empty_line(lines[i]) {
      i = i + 1;
    } else {
      let indent = get_indent(lines[i]);
      if indent != base_indent || !is_list_item(lines[i]) {
        parsing = false;
      } else {
        let after_dash = strip_list_prefix(lines[i]);
        // after_dash may be "key: value" or just "value" or empty (nested)
        if after_dash == "" {
          // list item whose value is an indented block
          let mut peek: Int = i + 1;
          while peek < len(lines) && is_empty_line(lines[peek]) {
            peek = peek + 1;
          }
          if peek < len(lines) && get_indent(lines[peek]) > base_indent {
            match parse_block(lines, peek, base_indent + 1) {
              BlockSuccess(nested, next_i) => {
                items = items ++ [nested];
                i = next_i;
              },
              BlockError(err) => return BlockError(err)
            }
          } else {
            items = items ++ [YamlNull];
            i = i + 1;
          }
        } else {
          match split_first_colon(after_dash) {
            Some((k, v)) => {
              // list item is a mapping with first pair (k, v) plus continuation lines
              let key_indent = base_indent + 2;
              let mut first_pairs: [(String, YamlValue)] = [(k, YamlNull)];
              let mut next_i: Int = i + 1;
              if v != "" {
                first_pairs = [(k, parse_scalar(v))];
              } else {
                // "k:" may own a deeper block or a sequence at the key's indent.
                let mut peek: Int = i + 1;
                while peek < len(lines) && is_empty_line(lines[peek]) {
                  peek = peek + 1;
                }
                if peek < len(lines) && (get_indent(lines[peek]) > key_indent ||
                    (get_indent(lines[peek]) == key_indent && is_list_item(lines[peek]))) {
                  match parse_block(lines, peek, key_indent) {
                    BlockSuccess(nested, end_i) => {
                      first_pairs = [(k, nested)];
                      next_i = end_i;
                    },
                    BlockError(err) => return BlockError(err)
                  }
                }
              }
              // Remaining indented keys belong to this item, not to its first key.
              let mut peek: Int = next_i;
              while peek < len(lines) && is_empty_line(lines[peek]) {
                peek = peek + 1;
              }
              if peek < len(lines) && get_indent(lines[peek]) >= key_indent && !is_list_item(lines[peek]) {
                match parse_mapping(lines, peek, get_indent(lines[peek])) {
                  BlockSuccess(YamlMapping(rest_pairs), end_i) => {
                    first_pairs = first_pairs ++ rest_pairs;
                    next_i = end_i;
                  },
                  BlockError(err) => return BlockError(err),
                  _ => ()
                }
              }
              items = items ++ [YamlMapping(first_pairs)];
              i = next_i;
            },
            None => {
              let scalar = parse_scalar(after_dash);
              items = items ++ [scalar];
              i = i + 1;
            }
          }
        }
      }
    }
  }
  BlockSuccess(YamlSequence(items), i)
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

pub fn parse_yaml(input: String) -> ParseResult {
  let lines = split_lines(input);
  // Streams are not implemented; never silently accept one document from a stream.
  let mut marker_i: Int = 0;
  while marker_i < len(lines) {
    if is_document_separator(lines[marker_i]) {
      return ParseError(line_error(lines[marker_i], marker_i, "Document separators are not supported"));
    }
    marker_i = marker_i + 1;
  }
  // skip leading empty
  let mut start: Int = 0;
  while start < len(lines) && is_empty_line(lines[start]) {
    start = start + 1;
  }
  if start >= len(lines) {
    let empty_doc: AstDocument = #{
      version: None,
      tags: None,
      root: YamlMapping([]),
      resources: []
    };
    return ParseSuccess(empty_doc);
  }
  let (root, next) = match parse_block(lines, start, get_indent(lines[start])) {
    BlockSuccess(value, next_i) => (value, next_i),
    BlockError(err) => return ParseError(err)
  };
  let mut remaining: Int = next;
  while remaining < len(lines) && is_empty_line(lines[remaining]) {
    remaining = remaining + 1;
  }
  if remaining < len(lines) {
    return ParseError(line_error(lines[remaining], remaining, "Unexpected content after the parsed block"));
  }
  // collect resources: if root is a mapping with apiVersion+kind, treat as one resource
  let mut resources: [K8sResource] = [];
  match root {
    YamlMapping(pairs) => {
      let mut has_api: Bool = false;
      let mut has_kind: Bool = false;
      for (k, _v) in pairs {
        if k == "apiVersion" { has_api = true; }
        if k == "kind" { has_kind = true; }
      }
      if has_api && has_kind {
        // dispatch to generic resource for now; specialised kinds to follow in Lint
        resources = [K8sGeneric(pairs)];
      }
    },
    _ => ()
  }
  let doc: AstDocument = #{
    version: None,
    tags: None,
    root: root,
    resources: resources
  };
  ParseSuccess(doc)
}

pub fn parse_k8s_resources(input: String) -> [K8sResource] {
  match parse_yaml(input) {
    ParseSuccess(doc) => doc.resources,
    ParseError(_e) => []
  }
}
