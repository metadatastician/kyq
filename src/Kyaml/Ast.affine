//
// KYAML Abstract Syntax Tree types
// Defines the data structures for representing parsed Kubernetes YAML

module Kyaml.Ast;

use prelude::{ Option, Some, None };

// YAML Value types - represents any YAML value
pub type YamlValue =
    YamlNull
  | YamlBool(Bool)
  | YamlInt(Int)
  | YamlFloat(Float)
  | YamlString(String)
  | YamlSequence([YamlValue])
  | YamlMapping([(String, YamlValue)])
  | YamlAnchor(String)
  | YamlAlias(String)
  | YamlTag(String, String)

// Simplified K8s Resource representation
pub type K8sResource =
    K8sPod([(String, YamlValue)])
  | K8sDeployment([(String, YamlValue)])
  | K8sService([(String, YamlValue)])
  | K8sConfigMap([(String, YamlValue)])
  | K8sSecret([(String, YamlValue)])
  | K8sGeneric([(String, YamlValue)])

// Metadata common to all K8s resources
pub struct ObjectMeta {
  name: Option[String],
  namespace: Option[String],
  labels: Option[[(String, String)]],
  annotations: Option[[(String, String)]],
  uid: Option[String],
  resource_version: Option[String]
}

// Parse result types
pub type ParseResult =
    ParseSuccess(AstDocument)
  | ParseError(ParseErrorDetail)

pub struct AstDocument {
  version: Option[String],
  tags: Option[[(String, String)]],
  root: YamlValue,
  resources: [K8sResource]
}

pub struct ParseErrorDetail {
  message: String,
  line: Option[Int],
  column: Option[Int],
  context: Option[String]
}

// Lint severity levels
pub type LintSeverity =
    LintError
  | LintWarning
  | LintInfo

// Lint issue location
pub struct LintLocation {
  line: Option[Int],
  column: Option[Int],
  path: Option[String]
}

// Lint issue
pub struct LintIssue {
  rule: String,
  message: String,
  severity: LintSeverity,
  location: LintLocation
}
