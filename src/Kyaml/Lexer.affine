// KYAML Lexer — stub that type-checks; full lexing in Phase 1 (A3)

module Kyaml.Lexer;

use Kyaml.Ast;
use prelude::{ Option, Some, None };

pub type Token =
    TokStreamStart
  | TokStreamEnd
  | TokDocumentStart
  | TokDocumentEnd
  | TokBlockMappingStart
  | TokBlockSequenceStart
  | TokBlockEntry
  | TokFlowMappingStart
  | TokFlowMappingEnd
  | TokFlowSequenceStart
  | TokFlowSequenceEnd
  | TokFlowEntry
  | TokScalar(String)
  | TokInt(Int)
  | TokFloat(Float)
  | TokBool(Bool)
  | TokNull
  | TokAnchor(String)
  | TokAlias(String)
  | TokTag(String)
  | TokComment(String)
  | TokNewline
  | TokIndent
  | TokDedent
  | TokError(String)

pub struct TokenPosition {
  line: Int,
  column: Int,
  index: Int
}

pub struct PositionedToken {
  token: Token,
  position: TokenPosition
}

pub struct Lexer {
  input: String,
  position: Int,
  line: Int,
  column: Int
}

pub fn new(input: String) -> Lexer {
  #{ input: input, position: 0, line: 1, column: 1 }
}

pub fn tokenize(lexer: Lexer) -> [PositionedToken] {
  // stub: return single StreamStart/StreamEnd pair so Parser can succeed on empty
  let start: PositionedToken = #{
    token: TokStreamStart,
    position: #{ line: 1, column: 1, index: 0 }
  };
  let end: PositionedToken = #{
    token: TokStreamEnd,
    position: #{ line: 1, column: 1, index: len(lexer.input) }
  };
  [start, end]
}
