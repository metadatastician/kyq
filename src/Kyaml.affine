// KYAML — Main module for Kubernetes YAML processing
// High-level API for parsing, linting, and querying Kubernetes manifests

module Kyaml;

use Kyaml.Ast::*;
use Kyaml.Lexer::{ new as new_lexer, tokenize, TokError };
use Kyaml.Parser::{ parse_yaml as parse_yaml_impl, parse_k8s_resources };
use prelude::{ Option, Some, None };

// Imported struct definitions are absent from v0.1.1's importer type
// environment. These public structural aliases preserve the AST field layout
// for lint results until the upstream import fix can be adopted.
pub type LintLocationValue = {
  line: Option[Int],
  column: Option[Int],
  path: Option[String]
}

pub type LintIssueValue = {
  rule: String,
  message: String,
  severity: LintSeverity,
  location: LintLocationValue
}

pub fn parse_yaml(input: String) -> ParseResult {
  parse_yaml_impl(input)
}

pub fn parse_k8s(input: String) -> [K8sResource] {
  parse_k8s_resources(input)
}

pub fn validate_yaml_syntax(input: String) -> Bool {
  let lexer = new_lexer(input);
  let tokens = tokenize(lexer);
  for tok in tokens {
    match tok.token {
      TokError(_) => return false,
      _ => ()
    }
  }
  true
}

pub fn lint_k8s(yaml: String) -> [LintIssueValue] {
  let mut issues: [LintIssueValue] = [];
  match parse_yaml(yaml) {
    // A5 will add the required-fields rule; its current implementation is a
    // stub, so a successful parse contributes no issues in A4.
    ParseSuccess(_) => (),
    ParseError(err) => {
      let issue: LintIssueValue = #{
        rule: "syntax-error",
        message: "YAML syntax error: " ++ err.message,
        severity: LintError,
        location: #{
          line: err.line,
          column: err.column,
          path: None
        }
      };
      issues = issues ++ [issue];
    }
  };
  issues
}

pub fn query_yaml(yaml: String, path: String) -> Option[YamlValue] {
  match parse_yaml(yaml) {
    ParseSuccess(doc) => query_value(doc.root, path),
    ParseError(_) => None
  }
}

fn query_value(value: YamlValue, path: String) -> Option[YamlValue] {
  let parts = split_path(path);
  if len(parts) == 0 {
    return Some(value);
  }
  let mut current: Option[YamlValue] = Some(value);
  for part in parts {
    match current {
      Some(cur) => {
        match cur {
          YamlMapping(pairs) => {
            let mut found: Option[YamlValue] = None;
            for (k, v) in pairs {
              if k == part {
                found = Some(v);
              }
            }
            current = found;
          },
          YamlSequence(seq) => {
            match parse_int(part) {
              Some(idx) => {
                if idx >= 0 && idx < len(seq) {
                  current = Some(seq[idx]);
                } else {
                  current = None;
                }
              },
              None => { current = None; }
            }
          },
          _ => { current = None; }
        }
      },
      None => { return None; }
    };
    match current {
      None => return None,
      Some(_) => ()
    }
  }
  current
}

fn split_path(path: String) -> [String] {
  let mut parts: [String] = [];
  let mut cur: String = "";
  let mut i: Int = 0;
  while i < len(path) {
    let ch = string_get(path, i);
    if ch == '.' {
      parts = parts ++ [cur];
      cur = "";
    } else {
      cur = cur ++ string_sub(path, i, 1);
    }
    i = i + 1;
  }
  if cur != "" {
    parts = parts ++ [cur];
  }
  parts
}

fn parse_int(s: String) -> Option[Int] {
  // delegate to stdlib parse_int (string.affine) when toolchain supports it
  // temporary stub — handles small non-negative decimals for query indexes
  if len(s) == 0 { return None; }
  let mut n: Int = 0;
  let mut i: Int = 0;
  while i < len(s) {
    let ch = string_get(s, i);
    if ch == '-' {
      if i != 0 { return None; }
    } else if char_to_int(ch) >= char_to_int('0') && char_to_int(ch) <= char_to_int('9') {
      n = n * 10 + (char_to_int(ch) - char_to_int('0'));
    } else {
      return None;
    }
    i = i + 1;
  }
  // sign handling is minimal for index use
  if string_get(s, 0) == '-' {
    Some(0 - n)
  } else {
    Some(n)
  }
}

pub fn get_yaml(yaml: String, path: String) -> Option[YamlValue] {
  query_yaml(yaml, path)
}

pub fn set_yaml(yaml: String, path: String, value: YamlValue) -> Option[String] {
  None
}

pub fn del_yaml(yaml: String, path: String) -> Option[String] {
  None
}

pub fn pretty_print_yaml(yaml: String) -> Option[String] {
  match parse_yaml(yaml) {
    ParseSuccess(doc) => Some(format_yaml(doc.root)),
    ParseError(_) => None
  }
}

fn format_yaml(value: YamlValue) -> String {
  format_yaml_inner(value, 0)
}

fn format_yaml_inner(value: YamlValue, indent: Int) -> String {
  match value {
    YamlNull => "null",
    YamlBool(b) => if b { "true" } else { "false" },
    YamlInt(i) => int_to_string(i),
    YamlFloat(f) => float_to_string(f),
    YamlString(s) => s,
    YamlSequence(seq) => {
      if len(seq) == 0 {
        "[]"
      } else {
        let mut out: String = "\n";
        for item in seq {
          out = out ++ "  - " ++ format_yaml_inner(item, indent + 2) ++ "\n";
        }
        out
      }
    },
    YamlMapping(pairs) => {
      if len(pairs) == 0 {
        "{}"
      } else {
        let mut out: String = "";
        for (k, v) in pairs {
          out = out ++ k ++ ": " ++ format_yaml_inner(v, indent + 2) ++ "\n";
        }
        out
      }
    },
    YamlAnchor(s) => "&" ++ s,
    YamlAlias(s) => "*" ++ s,
    YamlTag(h, suffix) => "!<" ++ h ++ ">" ++ suffix
  }
}
