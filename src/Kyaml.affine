// KYAML — Main module for Kubernetes YAML processing
// High-level API for parsing, linting, and querying Kubernetes manifests

module Kyaml;

use Kyaml.Ast;
use Kyaml.Lexer;
use Kyaml.Parser;
use Kyaml.Lint.RequiredFields;
use prelude::{ Option, Some, None };
use dict;

// Parse YAML string and return AST document (stub — delegates to Parser)
pub fn parse_yaml(input: String) -> ParseResult {
  Parser::parse_yaml(input)
}

// Parse YAML string and return Kubernetes resources
pub fn parse_k8s(input: String) -> [K8sResource] {
  Parser::parse_k8s_resources(input)
}

// Validate YAML syntax without full parsing
pub fn validate_yaml_syntax(input: String) -> Bool {
  let lexer = Lexer::new(input);
  let tokens = Lexer::tokenize(lexer);
  for tok in tokens {
    match tok.token {
      Lexer::Token::TokError(_msg) => return false,
      _ => ()
    }
  }
  true
}

// Lint Kubernetes YAML with all available rules
pub fn lint_k8s(yaml: String) -> [LintIssue] {
  let mut issues: [LintIssue] = [];
  match parse_yaml(yaml) {
    ParseSuccess(doc) => {
      let req = RequiredFields::lint_required_fields(doc);
      issues = issues ++ req;
    },
    ParseError(err) => {
      let issue: LintIssue = #{
        rule: "syntax-error",
        message: "YAML syntax error: " ++ err.message,
        severity: LintError,
        location: #{
          line: err.line,
          column: err.column,
          path: None
        }
      };
      issues = issues ++ [issue];
    }
  }
  issues
}

// Query YAML with a path expression (simplified)
pub fn query_yaml(yaml: String, path: String) -> Option[YamlValue] {
  match parse_yaml(yaml) {
    ParseSuccess(doc) => query_value(doc.root, path),
    ParseError(_e) => None
  }
}

fn query_value(value: YamlValue, path: String) -> Option[YamlValue] {
  let parts = split_path(path);
  if len(parts) == 0 {
    return Some(value);
  }
  let mut current: Option[YamlValue] = Some(value);
  for part in parts {
    match current {
      Some(cur) => {
        match cur {
          YamlMapping(pairs) => {
            // linear search in assoc list
            let mut found: Option[YamlValue] = None;
            for (k, v) in pairs {
              if k == part {
                found = Some(v);
              }
            }
            current = found;
          },
          YamlSequence(seq) => {
            match parse_int(part) {
              Some(idx) => {
                if idx >= 0 && idx < len(seq) {
                  current = Some(seq[idx]);
                } else {
                  current = None;
                }
              },
              None => { current = None; }
            }
          },
          _ => { current = None; }
        }
      },
      None => { return None; }
    }
    match current {
      None => return None,
      Some(_v) => ()
    }
  }
  current
}

fn split_path(path: String) -> [String] {
  // minimal: split on '.' — proper implementation in Phase 1
  let mut parts: [String] = [];
  let mut cur: String = "";
  for ch in path {
    if ch == '.' {
      parts = parts ++ [cur];
      cur = "";
    } else {
      cur = cur ++ ch;
    }
  }
  if cur != "" {
    parts = parts ++ [cur];
  }
  parts
}

fn parse_int(s: String) -> Option[Int] {
  // stub: delegate to Int::from_string when available
  // for now return None to satisfy type-check, will be implemented with string.affine helpers
  None
}

pub fn get_yaml(yaml: String, path: String) -> Option[YamlValue] {
  query_yaml(yaml, path)
}

// Set/delete/format helpers — stubs that type-check, full logic in Phase 1
pub fn set_yaml(yaml: String, path: String, value: YamlValue) -> Option[String] {
  None
}

pub fn del_yaml(yaml: String, path: String) -> Option[String] {
  None
}

pub fn pretty_print_yaml(yaml: String) -> Option[String] {
  match parse_yaml(yaml) {
    ParseSuccess(doc) => Some(format_yaml(doc.root)),
    ParseError(_e) => None
  }
}

fn format_yaml(value: YamlValue) -> String {
  format_yaml_inner(value, 0)
}

fn format_yaml_inner(value: YamlValue, indent: Int) -> String {
  match value {
    YamlNull => "null",
    YamlBool(b) => if b { "true" } else { "false" },
    YamlInt(i) => Int::to_string(i),
    YamlFloat(f) => Float::to_string(f),
    YamlString(s) => s,
    YamlSequence(seq) => {
      if len(seq) == 0 {
        "[]"
      } else {
        let mut out: String = "\n";
        for item in seq {
          out = out ++ "  - " ++ format_yaml_inner(item, indent + 2) ++ "\n";
        }
        out
      }
    },
    YamlMapping(pairs) => {
      if len(pairs) == 0 {
        "{}"
      } else {
        let mut out: String = "";
        for (k, v) in pairs {
          out = out ++ k ++ ": " ++ format_yaml_inner(v, indent + 2) ++ "\n";
        }
        out
      }
    },
    YamlAnchor(s) => "&" ++ s,
    YamlAlias(s) => "*" ++ s,
    YamlTag(h, suffix) => "!<" ++ h ++ ">" ++ suffix
  }
}
